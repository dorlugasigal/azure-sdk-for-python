# Azure AI Foundry
AZURE_SUBSCRIPTION_ID=<your-subscription-id>
AZURE_RESOURCE_GROUP=<your-resource-group>
AZURE_AI_PROJECT_NAME=<your-project-name>
AZURE_AI_PROJECT_ENDPOINT=<your-foundry-endpoint>

# This is typically the same as the project endpoint
AZURE_OPENAI_ENDPOINT=${AZURE_AI_PROJECT_ENDPOINT}
AZURE_OPENAI_API_KEY=<your-api-key-or-leave-empty-for-managed-identity>

# Evaluation configuration
LOG_LEVEL=INFO
