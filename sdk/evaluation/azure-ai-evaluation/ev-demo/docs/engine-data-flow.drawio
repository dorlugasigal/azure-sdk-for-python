                <mxCell id="phase1" value="&#xa;Dataset" style="swimlane;startSize=25;fillColor=#f5f5f5;strokeColor=#cccccc;rounded=1;fontSize=14;fontStyle=1;fontColor=#888888;swimlaneLine=1;" vertex="1" parent="1">
